# VentStudio Lite HoReCa — environment configuration.
# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# The site runs on flat files with NO .env at all; add keys only for the features you use.

# --- Storage: flat-file by default. Set to 1 to use MySQL (import schema.sql first) ---
LT_DB_ENABLED=0
LT_DB_HOST=localhost
LT_DB_NAME=
LT_DB_USER=
LT_DB_PASS=

# --- Payments: Stripe (recommended) ---
LT_STRIPE_SECRET=
LT_STRIPE_PUBLISHABLE=
# Optional: PayPal
LT_PAYPAL_ENV=sandbox
LT_PAYPAL_CLIENT_ID=
LT_PAYPAL_SECRET=

# --- Email (SMTP) for order confirmations, invoices, kitchen & courier tickets ---
LT_SMTP_HOST=
LT_SMTP_PORT=587
LT_SMTP_SECURE=tls
LT_SMTP_USER=
LT_SMTP_PASS=
LT_MAIL_FROM=orders@example.com
LT_MAIL_FROM_NAME=VentStudio
LT_MAIL_TO=orders@example.com

# --- Operations notifications ---
LT_KITCHEN_EMAIL=
LT_COURIER_EMAIL=

# --- Optional integrations ---
LT_MAILCHIMP_KEY=
LT_MAILCHIMP_AUDIENCE=
LT_TURNSTILE_SECRET=
